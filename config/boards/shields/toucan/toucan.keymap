 * SPDX-License-Identifier: MIT
 *
 * Port of config/boards/shields/seven/seven.keymap onto the beekeeb Toucan2's
 * 42-key layout (6 cols x 3 rows + 3 thumb keys per hand, vs. seven's 5x3+3),
 * plus a new MOUSE layer restoring Toucan2's stock touch-to-click behavior.
 * See config/boards/shields/toucan/README-keymap-port.md for the position
 * mapping and what's new.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


#define DFLT      0
#define SYMBOLS   1
#define EXTRA     2
#define GAMING    3
#define LNUM      4
#define SYSTEM    5
#define MOUSE     6


/ {
    behaviors {
        hpl: hold_preferred_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
        bpl: balanced_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
        tpl: tap_preferred_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REFERRED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        hpm: hold_preferred_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };
        bpm: balanced_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        tpm: tap_preferred_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REFERRED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_print_screen_r_t {
            timeout-ms = <50>;
            // Positions 3,4 are R and T on row 0 — unchanged from seven's
            // numbering because toucan2's two new columns (5,6) sit *between*
            // the hands, so the left hand's columns 0-4 keep identical flat
            // key-position indices.
            key-positions = <3 4>;
            bindings = <&kp LC(LS(S))>;
            layers = <EXTRA>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q             &kp W           &kp E            &kp R           &kp T          &none  &none  &kp Y         &kp U        &kp I            &kp O         &kp P
                &bpm LSHIFT A     &tpm LCTRL S    &tpm LCTRL D     &tpm LALT F     &tpm LGUI G    &none  &none  &kp H         &kp J        &kp K            &kp L         &bpm LSHIFT SQT
                &tpm LCTRL Z      &kp X           &kp C            &kp V           &kp B          &none  &none  &kp N         &kp M        &kp COMMA        &kp DOT       &kp SLASH
                                                   &mo EXTRA        &bpl SYMBOLS SPACE &tpl LNUM TAB    &kp BACKSPACE &mo SYMBOLS  &mo EXTRA
            >;
        };

        symbols_layer {
            bindings = <
                &tpm LALT EXCL    &kp AT          &kp HASH         &kp DOLLAR       &kp PERCENT    &none  &none  &kp CARET     &kp N7       &kp N8           &kp N9        &kp MINUS
                &tpm LSHIFT GRAVE &tpm LCTRL EQUAL &tpm LCTRL UNDER &tpm LALT COLON &tpm LGUI LPAR &none  &none  &kp RPAR      &kp N4       &kp N5           &kp N6        &tpm LSHIFT N0
                &kp BACKSLASH     &kp AMPS        &kp STAR         &kp SEMI         &kp LBKT       &none  &none  &kp RBKT      &kp N1       &kp N2           &kp N3        &kp DOT
                                                   &kp BACKSPACE    &trans           &trans         &trans &trans       &kp DEL
            >;
        };

        extra_layer {
            bindings = <
                &tpm LALT LA(N1)  &kp LA(N2)      &kp LA(N3)       &kp LA(N4)       &tpl SYSTEM LA(N5) &none  &none  &kp INSERT    &kp HOME     &kp END          &sk PAGE_UP   &kp PAGE_UP
                &kp LSHIFT        &tpm LCTRL TAB  &tpm LCTRL ENTER &tpm LALT ESCAPE &kp C_NEXT         &none  &none  &kp LEFT      &kp DOWN     &kp UP           &kp RIGHT     &kp LSHIFT
                &caps_word        &trans          &kp C_VOL_DN     &kp C_VOL_UP     &kp C_PP           &none  &none  &trans        &trans       &trans           &trans        &trans
                                                   &trans           &trans           &to GAMING         &trans &trans       &kp DEL
            >;
        };

        gaming_layer {
            bindings = <
                &kp TAB           &kp Q           &kp W            &kp E            &kp R              &none  &none  &kp T         &kp N7       &kp N8           &kp N9        &kp MINUS
                &kp LSHIFT        &kp A           &kp S            &kp D            &kp F              &none  &none  &kp G         &kp N4       &kp N5           &kp N6        &kp N0
                &kp LALT          &kp Z           &kp X            &kp C            &kp V              &none  &none  &kp B         &kp N1       &kp N2           &kp N3        &kp DOT
                                                   &kp LCTRL        &kp SPACE        &mo LNUM           &to DFLT &trans      &kp DEL
            >;
        };

        left_num_layer {
            bindings = <
                &kp LEFT          &kp N1           &kp N2          &kp N3           &kp RIGHT         &none  &none  &trans        &trans       &trans          &trans         &trans
                &kp UP            &kp N4           &kp N5          &kp N6           &kp N0            &none  &none  &trans        &trans       &trans          &kp LSHIFT     &trans
                &kp DOWN          &kp N7           &kp N8          &kp N9           &kp MINUS         &none  &none  &trans        &trans       &trans          &trans         &trans
                                                    &to DFLT        &trans           &kp DOT           &kp BACKSPACE &trans      &trans
            >;
        };

        system_layer {
            bindings = <
                &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &trans             &none  &none  &trans        &kp F1       &kp F2          &kp F3         &kp F10
                &trans            &out OUT_USB    &out OUT_BLE     &trans           &sys_reset         &none  &none  &trans        &kp F4       &kp F5          &kp F6         &kp F11
                &bootloader       &bt BT_CLR      &trans           &trans           &trans             &none  &none  &trans        &kp F7       &kp F8          &kp F9         &kp F12
                                                   &trans           &trans           &trans             &trans &trans       &bootloader
            >;
        };

        // New — not a seven layer. Toucan2's stock keymap activates this
        // momentarily (&mo, matched in toucan.dtsi's is_touching_processor)
        // whenever a finger touches the trackpad, so the right thumb keys
        // become mouse-click buttons while touching. Everything else stays
        // &trans to the layer already active underneath. See
        // README-keymap-port.md.
        mouse_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans          &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };
    };
};
