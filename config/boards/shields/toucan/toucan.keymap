 *
 * Port of config/boards/shields/seven/seven.keymap onto the beekeeb Toucan2's
 * 42-key layout (6 cols x 3 rows + 3 thumb keys per hand, vs. seven's 5x3+3),
 * plus a new MOUSE layer restoring Toucan2's stock touch-to-click behavior.
 * See config/boards/shields/toucan/README-keymap-port.md for the position
 * mapping and what's new.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


#define DFLT      0
#define SYMBOLS   1
#define EXTRA     2
#define GAMING    3
#define LNUM      4
#define SYSTEM    5
#define MOUSE     6


/ {
    behaviors {
        hpl: hold_preferred_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
        bpl: balanced_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
        tpl: tap_preferred_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REFERRED_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        hpm: hold_preferred_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };
        bpm: balanced_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        tpm: tap_preferred_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REFERRED_MODIFIER";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_print_screen_r_t {
            timeout-ms = <50>;
            // Positions 4,5 are R and T on row 0. Toucan2's one new column
            // per hand sits at the *outer* edge (col 0 / col 11, &none on
            // every layer), so seven's columns 0-4 land one position inward,
            // at toucan cols 1-5 — see README-keymap-port.md.
            key-positions = <4 5>;
            bindings = <&kp LC(LS(S))>;
            layers = <EXTRA>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DFLT";
            bindings = <
                &none  &kp Q             &kp W           &kp E            &kp R           &kp T          &kp Y         &kp U        &kp I            &kp O         &kp P          &none
                &none  &bpm LSHIFT A     &tpm LCTRL S    &tpm LCTRL D     &tpm LALT F     &tpm LGUI G    &kp H         &kp J        &kp K            &kp L         &bpm LSHIFT SQT &none
                &none  &tpm LCTRL Z      &kp X           &kp C            &kp V           &kp B          &kp N         &kp M        &kp COMMA        &kp DOT       &kp SLASH      &none
                                                          &mo EXTRA        &bpl SYMBOLS SPACE &tpl LNUM TAB    &kp BACKSPACE &mkp RCLK    &mkp LCLK
            >;
        };

        symbols_layer {
            display-name = "SYMBOLS";
            bindings = <
                &none  &tpm LALT EXCL    &kp AT          &kp HASH         &kp DOLLAR       &kp PERCENT    &kp CARET     &kp N7       &kp N8           &kp N9        &kp MINUS      &none
                &none  &tpm LSHIFT GRAVE &tpm LCTRL EQUAL &tpm LCTRL UNDER &tpm LALT COLON &tpm LGUI LPAR &kp RPAR      &kp N4       &kp N5           &kp N6        &tpm LSHIFT N0 &none
                &none  &kp BACKSLASH     &kp AMPS        &kp STAR         &kp SEMI         &kp LBKT       &kp RBKT      &kp N1       &kp N2           &kp N3        &kp DOT        &none
                                                          &kp BACKSPACE    &trans           &trans         &trans &trans       &kp DEL
            >;
        };

        extra_layer {
            display-name = "EXTRA";
            bindings = <
                &none  &tpm LALT LA(N1)  &kp LA(N2)      &kp LA(N3)       &kp LA(N4)       &tpl SYSTEM LA(N5) &kp INSERT    &kp HOME     &kp END          &sk PAGE_UP   &kp PAGE_UP &none
                &none  &kp LSHIFT        &tpm LCTRL TAB  &tpm LCTRL ENTER &tpm LALT ESCAPE &kp C_NEXT         &kp LEFT      &kp DOWN     &kp UP           &kp RIGHT     &kp LSHIFT  &none
                &none  &caps_word        &trans          &kp C_VOL_DN     &kp C_VOL_UP     &kp C_PP           &trans        &trans       &trans           &trans        &trans      &none
                                                          &trans           &trans           &to GAMING         &trans &trans       &kp DEL
            >;
        };

        gaming_layer {
            display-name = "GAMING";
            bindings = <
                &none  &kp TAB           &kp Q           &kp W            &kp E            &kp R              &kp T         &kp N7       &kp N8           &kp N9        &kp MINUS &none
                &none  &kp LSHIFT        &kp A           &kp S            &kp D            &kp F              &kp G         &kp N4       &kp N5           &kp N6        &kp N0    &none
                &none  &kp LALT          &kp Z           &kp X            &kp C            &kp V              &kp B         &kp N1       &kp N2           &kp N3        &kp DOT   &none
                                                          &kp LCTRL        &kp SPACE        &mo LNUM           &to DFLT &trans      &kp DEL
            >;
        };

        left_num_layer {
            display-name = "LNUM";
            bindings = <
                &none  &kp LEFT          &kp N1           &kp N2          &kp N3           &kp RIGHT         &trans        &trans       &trans          &trans         &trans     &none
                &none  &kp UP            &kp N4           &kp N5          &kp N6           &kp N0            &trans        &trans       &trans          &kp LSHIFT     &trans     &none
                &none  &kp DOWN          &kp N7           &kp N8          &kp N9           &kp MINUS         &trans        &trans       &trans          &trans         &trans     &none
                                                            &to DFLT        &trans           &kp DOT           &kp BACKSPACE &trans      &trans
            >;
        };

        system_layer {
            display-name = "SYSTEM";
            bindings = <
                &none  &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &trans             &trans        &kp F1       &kp F2          &kp F3         &kp F10 &none
                &none  &trans            &out OUT_USB    &out OUT_BLE     &trans           &sys_reset         &trans        &kp F4       &kp F5          &kp F6         &kp F11 &none
                &none  &bootloader       &bt BT_CLR      &trans           &trans           &trans             &trans        &kp F7       &kp F8          &kp F9         &kp F12 &none
                                                          &trans           &trans           &trans             &trans &trans       &bootloader
            >;
        };

        // New — not a seven layer. Toucan2's stock keymap activates this
        // momentarily (&mo, matched in toucan.dtsi's is_touching_processor)
        // whenever a finger touches the trackpad, so the right thumb keys
        // become mouse-click buttons while touching. Everything else stays
        // &trans to the layer already active underneath. See
        // README-keymap-port.md.
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans          &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };
    };
};
